<link rel="stylesheet" href="/resurse/css/galerie.css">
<section id="galerie-statica">
  <div class="wrapper">
    <div id="text-reflexie">Galerie chitare</div>
    <div id="text-reflectat">Galerie chitare</div>
  </div>
  <div id="grid-galerie">
    <% const vectLuni=[ "ianuarie" , "februarie" , "martie" , "aprilie" , "mai" , "iunie" , "iulie" , "august"
      , "septembrie" , "octombrie" , "noiembrie" , "decembrie" ]; %>
      <%# const lunaCurenta=vectLuni[new Date().getMonth()]; %>
        <% const lunaCurenta=vectLuni[new Date("2026-12-25").getMonth()]; // Testăm cu Decembrie în loc de luna curentă
          %>
          <% let contor=0; %>
            <% for (let imag of locals.imagini) { %>
              <% if (contor < 12 && imag.luni?.includes(lunaCurenta)) { %>
                <figure>
                  <picture>
                    <source srcset="<%- imag.fisier_mic %>" media="(max-width:768px)">
                    <source srcset="<%- imag.fisier_mediu %>" media="(max-width:1024px)">
                    <img src="<%- imag.cale_fisier %>" alt="<%- imag.alt %>" title="<%- imag.titlu %>">
                  </picture>
                  <figcaption>
                    <p class="text-figcaption"><%- imag.text_descriere %>
                    </p>
                  </figcaption>
                </figure>
                <% contor++; %>
                  <% } %>
                    <% } %>
  </div>
</section>