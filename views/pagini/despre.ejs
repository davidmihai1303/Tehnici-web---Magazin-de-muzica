<!doctype html>
<html lang="ro">

<head>
    <%- include('../fragmente/head') %>
        <meta name="description"
            content="Oferim o gamă variată de instrumente și accesorii pentru muzicienii de toate nivelurile, la cele mai bune prețuri din București.">
        <meta name="keywords"
            content="instrumente, muzica, chitara, bucuresti, vinyl, accesorii, studio, scena, boxe, mixere, microfoane, amplificator, corzi, pene, bețe de tobă, acordoare, cabluri">
        <title>A doua pagina</title>
        <link rel="stylesheet" href="/resurse/css/video.css">
</head>

<body>

    <%- include('../fragmente/header') %>

        <main>
            <video id="video-principal" poster="/resurse/video/acordeon.png" controls preload="auto">

                <source src="/resurse/video/cal_acordeon.mp4" type="video/mp4">
                <source src="/resurse/video/cal_acordeon.ogg" type="video/ogg">

                <track src="/resurse/video/subtitrari-ro.vtt" kind="subtitles" srclang="ro" label="Română" default>

                <track src="/resurse/video/subtitrari-en.vtt" kind="subtitles" srclang="en" label="English">

                Browserul dvs. nu suportă elementul video HTML5.
            </video>

            <br><br>

            <p><button class="btn btn-primary">Buton Bootstrap</button></p>
        </main>

        <%- include('../fragmente/footer') %>

</body>

</html>